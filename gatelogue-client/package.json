{
  "name": "gatelogue-client",
  "version": "3.1.4+13",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build --base=/gatelogue",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint ${@:-src/}",
    "lint:fix": "eslint --fix ${@:-src/}",
    "lint:sarif": "eslint -f @_7d/eslint-formatter-sarif --fix ${@:-src/} || true",
    "format": "prettier --write ${@:-.}",
    "format:check": "prettier --check ${@:-.}"
  },
  "dependencies": {
    "gatelogue-types": "workspace:../gatelogue-types-ts",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "vue": "3.5.43",
    "vue-router": "5.3.1",
    "vue-tippy": "6.8.0"
  },
  "devDependencies": {
    "@_7d/eslint-formatter-sarif": "1.0.1",
    "@eslint/js": "10.0.1",
    "@tsconfig/node24": "24.0.5",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.13.5",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.0",
    "globals": "17.12.0",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-vue-devtools": "8.2.1",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11"
  },
  "packageManager": "pnpm@12.5.0"
}
