{
  "name": "gatelogue-client",
  "version": "3.1.5+13",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build --base=/gatelogue",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint ${@:-src/}",
    "lint:fix": "eslint --fix ${@:-src/}",
    "format": "prettier --write ${@:-.}",
    "format:check": "prettier --check ${@:-.}"
  },
  "dependencies": {
    "gatelogue-types": "workspace:../gatelogue-types-ts",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "vue": "3.5.45",
    "vue-router": "5.5.1",
    "vue-tippy": "6.8.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tsconfig/node26": "26.0.2",
    "@tsconfig/strictest": "2.0.9",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "npm-run-all2": "9.1.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vite-plugin-vue-devtools": "8.2.1",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14"
  },
  "packageManager": "pnpm@12.22.0"
}
