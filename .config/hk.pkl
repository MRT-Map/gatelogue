amends "package://github.com/jdx/hk/releases/download/v2.8.0/hk@2.8.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.8.0/hk@2.8.0#/Builtins.pkl"
import "package://github.com/iiiii7d/hk/releases/download/v2.8.0-7/hk@2.8.0-7#/Cargo.pkl"
import "package://github.com/iiiii7d/hk/releases/download/v2.8.0-7/hk@2.8.0-7#/Pnpm.pkl"
import "package://github.com/iiiii7d/hk/releases/download/v2.8.0-7/hk@2.8.0-7#/Hatch.pkl"
import "package://github.com/iiiii7d/hk/releases/download/v2.8.0-7/hk@2.8.0-7#/Misc.pkl"

local init = new Group {
    steps {
        ["init_types_ts"] = new Step {
            glob = "**/*"
            dir = "gatelogue-types-ts"
            check = "pnpm i && pnpm compile-sql"
        }
        ["init_client"] = new Step {
            depends = List("init_types_ts")
            glob = "**/*"
            dir = "gatelogue-client"
            check = "pnpm i"
        }
        ["copy-sql"] = new Step {
            glob = "gatelogue-types-sql/**/*"
            fix = "gatelogue-types-sql/copy.sh"
        }
    }
}

local formatters = new Mapping<String, Step> {
    ["ruff_fmt"] = Hatch.hatch_check_fmt
    ["prettier"] = (Pnpm.pnpm_format) {
        depends = List("init_client")
    }
    ["cargo_fmt"] = Cargo.cargo_fmt
}

local linters = new Mapping<String, Step> {
    ["ruff"] = Hatch.hatch_check_code
    ["eslint"] = (Pnpm.pnpm_lint) {
        depends = List("init_client")
    }
    ["cargo_clippy"] = Cargo.cargo_clippy
    ["zizmor"] = Misc.zizmor
    ["actionlint"] = Misc.actionlint
    ["poutine"] = Misc.poutine
    ["shellcheck"] = Misc.shellcheck
}
local type_checkers = new Mapping<String, Step> {
    ["pyrefly"] = Hatch.hatch_check_types
    ["tsc"] = (Pnpm.pnpm_type_check) {
        depends = List("init_client")
    }
}
local sarif = new Mapping<String, Step> {
    ["mkdir"] = Misc.mkdir_sarif(".sarif")
    ["eslint"] = (Pnpm.pnpm_lint_sarif("../.sarif")) {
        depends = List("init_client")
    }
    ["ruff"] = Hatch.hatch_check_code_sarif("../.sarif")
    ["cargo_clippy"] = Cargo.cargo_clippy_sarif(".sarif")
    ["zizmor"] = Misc.zizmor_sarif(".sarif")
    ["actionlint"] = Misc.actionlint_sarif(".sarif")
    ["poutine"] = Misc.poutine_sarif(".sarif")
    ...type_checkers
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = new Mapping<String, Step | Group> {
            ["init"] = init
            ...formatters
            ...linters
            ...type_checkers
        }
    }
    ["fix"] {
        fix = true
        steps = new Mapping<String, Step | Group> {
            ["init"] = init
            ...formatters
            ...linters
            ...type_checkers
        }
    }
    ["check"] {
        steps = new Mapping<String, Step | Group> {
            ["init"] = init
            ...formatters
            ...linters
            ...type_checkers
        }
    }
    ["format"] {
        fix = true
        steps = new Mapping<String, Step | Group> {
            ["init"] = init
            ...formatters
        }
    }
    ["sarif"] {
        fix = true
        steps = new Mapping<String, Step | Group> {
            ["init"] = init
            ...sarif
        }
    }
}
