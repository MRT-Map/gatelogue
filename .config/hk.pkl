amends "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Builtins.pkl"
import "package://github.com/iiiii7d/hk/releases/download/v2.12.0-11/hk@2.12.0-11#/Cargo.pkl"
import "package://github.com/iiiii7d/hk/releases/download/v2.12.0-11/hk@2.12.0-11#/Pnpm.pkl"
import "package://github.com/iiiii7d/hk/releases/download/v2.12.0-11/hk@2.12.0-11#/Hatch.pkl"
import "package://github.com/iiiii7d/hk/releases/download/v2.12.0-11/hk@2.12.0-11#/Misc.pkl"

local init = new Group {
    steps {
        ["init_types_ts"] = new Step {
            glob = "**/*"
            dir = "gatelogue-types-ts"
            check = "pnpm i && pnpm compile-sql"
        }
        ["init_client"] = new Step {
            depends = List("init_types_ts")
            glob = "**/*"
            dir = "gatelogue-client"
            check = "pnpm i"
        }
        ["copy-sql"] = new Step {
            glob = "gatelogue-types-sql/**/*"
            fix = "gatelogue-types-sql/copy.sh"
        }
    }
}

local formatters = new Mapping<String, Step> {
    ["ruff_fmt"] = Hatch.check_fmt
    ["prettier"] = (Pnpm.format) {
        depends = List("init_client")
    }
    ["cargo_fmt"] = Cargo.fmt
}

local linters = new Mapping<String, Step> {
    ["ruff"] = Hatch.check_code
    ["eslint"] = (Pnpm.lint) {
        depends = List("init_client")
    }
    ["cargo_clippy"] = Cargo.clippy
    ...Misc.zizmor.steps
    ["actionlint"] = Misc.actionlint
    ...Misc.poutine.steps
    ["shellcheck"] = Misc.shellcheck
}
local type_checkers = new Mapping<String, Step> {
    ["pyrefly"] = Hatch.check_types
    ["tsc"] = (Pnpm.type_check) {
        depends = List("init_client")
    }
}

steps = new Mapping<String, Step | Group> {
    ["init"] = init
    ...formatters
    ...linters
    ...type_checkers
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
    }
}
