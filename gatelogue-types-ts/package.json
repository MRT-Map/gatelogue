{
  "name": "gatelogue-types",
  "version": "3.1.4+13",
  "license": "GPL-3.0-only",
  "author": {
    "name": "MRT Mapping Services",
    "url": "https://github.com/mrt-map"
  },
  "maintainers": [
    {
      "name": "7d",
      "email": "61975820+iiiii7d@users.noreply.github.com"
    }
  ],
  "description": "Types for loading and reading Gatelogue data",
  "repository": "github:MRT-Map/gatelogue",
  "homepage": "https://mrt-map.github.io/gatelogue",
  "bugs": "https://github.com/mrt-map/gatelogue/issues",
  "readme": "README.md",
  "keywords": [
    "gatelogue",
    "mrt",
    "minecart rapid transit"
  ],
  "type": "module",
  "scripts": {
    "test": "run-s compile-sql build:esm && node test.js",
    "build": "run-s compile-sql && run-p build:*",
    "build:esm": "tsc --outDir dist",
    "build:cjs": "tsc --outDir dist/cjs -m commonjs --verbatimModuleSyntax false --target es2017 --module preserve",
    "compile-sql": "node compile-sql.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint ${@:-src/}",
    "lint:fix": "eslint --fix ${@:-src/}",
    "lint:sarif": "eslint -f @_7d/eslint-formatter-sarif --fix ${@:-src/} || true",
    "format": "prettier --write ${@:-.}",
    "format:check": "prettier --check ${@:-.}",
    "doc": "run-s compile-sql && typedoc src/lib.ts",
    "prepublish": "run-p build && cp ../README.md .",
    "postpublish": "rm ./README.md"
  },
  "types": "./dist/lib.d.ts",
  "exports": {
    "import": "./dist/lib.js",
    "require": "./dist/cjs/lib.js"
  },
  "files": [
    "dist",
    "tsconfig.json"
  ],
  "peerDependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "better-sqlite3": "13.x"
  },
  "peerDependenciesMeta": {
    "@sqlite.org/sqlite-wasm": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@_7d/eslint-formatter-sarif": "1.0.1",
    "@eslint/js": "10.0.1",
    "@total-typescript/tsconfig": "1.0.4",
    "@tsconfig/strictest": "2.0.8",
    "@types/better-sqlite3": "9.6.0",
    "@types/sql.js": "1.4.11",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.8",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
